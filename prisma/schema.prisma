generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  address     String
  latitude    Float
  longitude   Float
  status      Boolean  @default(true)
  queueEntries QueueEntry[]
  queueDays   BranchQueueDay[]
  salesAgents SalesAgent[]
  counters    Counter[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model QueueEntry {
  id           Int      @id @default(autoincrement())
  queueDate    DateTime @db.Date
  ticketNumber String
  branchCode   String
  branch       Branch   @relation(fields: [branchCode], references: [code])
  name         String
  phoneNumber  String
  serviceType  String
  serviceId    Int
  service      Service  @relation(fields: [serviceId], references: [id])
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  queueHandlings QueueHandling[]

  @@unique([branchCode, ticketNumber])
}

model Service {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  name          String
  status        String
  queueEntries  QueueEntry[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model DailySequence {
  id            Int      @id @default(autoincrement())
  operatingDate DateTime
  branchCode    String
  serviceType   String
  nextNumber    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([operatingDate, branchCode, serviceType])
}

model BranchQueueDay {
  id            Int      @id @default(autoincrement())
  branchCode    String
  operatingDate DateTime
  status        String   @default("open")
  startedAt     DateTime?
  branch        Branch   @relation(fields: [branchCode], references: [code])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([branchCode, operatingDate])
}

model SalesAgent {
  id              Int                  @id @default(autoincrement())
  branchId        Int
  employeeId      String               @unique
  agentName       String
  status          String
  branch          Branch               @relation(fields: [branchId], references: [id])
  assignments     CounterAssignment[]
  queueHandlings  QueueHandling[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Counter {
  id              Int                  @id @default(autoincrement())
  branchId        Int
  counterCode     String               @unique
  counterName     String
  status          String
  branch          Branch               @relation(fields: [branchId], references: [id])
  assignments     CounterAssignment[]
  queueHandlings  QueueHandling[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model CounterAssignment {
  id            Int        @id @default(autoincrement())
  counterId     Int
  salesAgentId  Int
  assignedAt    DateTime
  unassignedAt  DateTime?
  status        String
  counter       Counter    @relation(fields: [counterId], references: [id])
  salesAgent    SalesAgent @relation(fields: [salesAgentId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model QueueHandling {
  id            Int        @id @default(autoincrement())
  queueId       Int
  salesAgentId  Int
  counterId     Int
  startTime     DateTime
  endTime       DateTime?
  status        String
  queue         QueueEntry @relation(fields: [queueId], references: [id])
  salesAgent    SalesAgent @relation(fields: [salesAgentId], references: [id])
  counter       Counter    @relation(fields: [counterId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
